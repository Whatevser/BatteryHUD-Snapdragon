<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Plain net10.0-windows, no Windows SDK version suffix. A versioned TFM such as
      net10.0-windows10.0.19041.0 pulls in the C#/WinRT projections (Microsoft.Windows.SDK.NET.dll,
      ~25 MB) and bundles them into the single-file exe. Nothing here uses WinRT - everything is
      Win32 P/Invoke, WMI and the registry - so that was 25 MB of dead weight.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!--
      MUST stay disabled. With UseWPF and UseWindowsForms both on, implicit usings pull in
      System.Drawing + System.Windows.Forms *and* System.Windows.Media + System.Windows.Controls,
      which makes Color, Brush, FontFamily, Panel, MouseEventArgs and Application ambiguous
      in every file. Each source file declares exactly the namespaces it needs instead.
    -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      WFO0003 (WFAC010 before .NET 10) is the WinForms analyzer asking for DPI mode to come from
      Application.SetHighDpiMode. That API only governs WinForms windows; every window here is
      WPF (WinForms supplies NotifyIcon and nothing else), and WPF takes its DPI awareness
      from the manifest. The manifest is the correct place.
    -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <AssemblyName>BatteryHud</AssemblyName>
    <RootNamespace>BatteryHud</RootNamespace>
    <StartupObject>BatteryHud.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\battery.ico</ApplicationIcon>

    <!-- ARM64 first. win-x64 kept only so the project can be built on an x64 dev box. -->
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Reflection-based JSON config + WPF: do not trim. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      Framework-dependent on purpose: the .NET 10 Desktop Runtime carries WPF and WinForms,
      so the published exe only has to hold our own code plus System.Management. That is
      what keeps it around a megabyte; self-contained is far larger.
    -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      portable, not embedded: an embedded PDB is carried inside the single-file exe and
      inflates it for no runtime benefit. portable writes BatteryHud.pdb alongside, which
      keeps line numbers in the log if you want them and is deletable if you do not.
    -->
    <DebugType>portable</DebugType>
    <Version>0.3.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
